# Copy to .env. Keep the real key only in .env or an OS environment variable.
# For local product preview, use CAMPUSFOOD_MODE=product and
# CAMPUSFOOD_COOKIE_SECURE=false while serving http://127.0.0.1 only.
# Keep Secure cookies enabled behind HTTPS when deploying beyond localhost.
CAMPUSFOOD_MODE=product
CAMPUSFOOD_COOKIE_SECURE=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
RAG_ENABLED=true
RAG_TIMEOUT_SECONDS=12
RAG_MAX_TOKENS=1800
RAG_MAX_CONTEXT_CHARS=24000
RAG_MAX_RESTAURANTS=5
